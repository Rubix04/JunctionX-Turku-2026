PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/tassuvahti.db
# Pet profile pictures are stored here
UPLOAD_DIR=./data/uploads
# At least 32 characters. Generate one with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=
# At least 32 characters. Never change it after launch: users are matched to accounts with it.
IDENTITY_HASH_SECRET=
# Seeds demo data (e.g. the spec's example pets) for new households
DEMO_MODE=true
# Public address of the server for share links (optional), e.g. https://api.tassuvahti.example
PUBLIC_BASE_URL=
# Seasonal alert pushes: off, log (development: only written to the log) or expo (really sent)
PUSH_MODE=log
# Optional, only if push security is enabled in the Expo project
EXPO_ACCESS_TOKEN=
